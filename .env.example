# ---- Core ----
APP_ENV=dev
# Dev default is SQLite so it runs with zero setup. To use Postgres (and the
# RLS policies in sql/schema.sql), set AGENT_HQ_DATABASE_URL — we deliberately
# do NOT read the generic DATABASE_URL because Replit injects it for the
# legacy TS app, which uses an incompatible schema.
# AGENT_HQ_DATABASE_URL=postgresql://USER:PASS@HOST/DB

# ---- Auth ----
# In dev we trust a header (X-Dev-User-Email) or fall back to this email.
# In prod, replace with Google Workspace SSO (see app/auth.py).
DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=jordan@onit.com
# Only Google accounts on these domains may sign in (prod SSO).
ALLOWED_EMAIL_DOMAINS=onit.com

# ---- LLM synthesis (optional) ----
# If set, the market-intel agent writes its narrative brief with Claude.
# If unset, it uses a deterministic template so the chassis still runs.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Worker ----
WORKER_POLL_SECONDS=2
